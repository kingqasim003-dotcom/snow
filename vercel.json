{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/lop/:path*", "destination": "/api" },
    { "source": "/lop", "destination": "/api" },
    { "source": "/((?!assets/|polar-bear|robots\\.txt|admin-panel/).*)", "destination": "/index.html" }
  ]
}