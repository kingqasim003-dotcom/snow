# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ALLOWED_ORIGINS=https://snowbear.online,https://www.snowbear.online

# Groq (server-side only)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Chrome extension path (dev zip build only)
EXTENSION_PATH=

# Firebase (client — safe to expose in browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=https://snowbear-online-default-rtdb.asia-southeast1.firebasedatabase.app

# ImgBB receipt uploads (server-side only)
IMGBB_API_KEY=

# Admin panel at /lop (server injects config — do not commit config.js passwords)
ADMIN_EMAIL=snowqasimbear@gmail.com
ADMIN_GATE_PASSWORD=your_gate_password
ADMIN_PASSWORD=your_firebase_admin_password